# Server port
PORT=5000

# CORS origin allowed during development (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Password for the private dashboard (/api/admin/* endpoints)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret URL the dashboard is served on. Keep it long and unguessable —
# `/admin` is intentionally NOT used, so visitors never find the panel.
ADMIN_PATH=/change-me-to-something-secret

# Set to production when serving the built frontend from Express
# NODE_ENV=production

# Public site URL used by the SEO bits (sitemap.xml, robots.txt, canonical,
# JSON-LD). After deploying set your real domain, e.g.:
# SITE_URL=https://your-name.onrender.com
# Leave it unset locally — the server then uses the address you opened it with.
# SITE_URL=
